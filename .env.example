# Gemini is optional; the assistant shows an unavailable notice until configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Assistant rate limits and request timeout (all optional).
# Per learner: 20 messages per 10 minutes. Global: 300 messages per minute.
ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_WINDOW_MINUTES=10
ASSISTANT_GLOBAL_LIMIT=300
ASSISTANT_TIMEOUT_MS=30000

# Server-side Firebase Admin credentials. Use either:
# 1. FIREBASE_SERVICE_ACCOUNT_JSON with the full service-account JSON value, or
# 2. GOOGLE_APPLICATION_CREDENTIALS pointing to a private service-account file.
FIREBASE_PROJECT_ID=eapihs-campusverse
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Render supplies PORT automatically.
