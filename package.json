{
  "name": "techpro-coc1",
  "version": "1.0.0",
  "private": true,
  "description": "TechPro CSS NC II — COC 1 interactive 100% offline learning app for Assemble Computer Hardware",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prestart": "npm run build",
    "build": "node scripts/build.mjs",
    "build:offline": "node scripts/build-offline-zip.mjs",
    "test": "node --test tests/*.test.js",
    "pretest": "npm run build",
    "check": "node scripts/check-content.js",
    "check:offline": "node scripts/check-offline.mjs",
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "build:games": "node scripts/build-games.mjs",
    "audit": "node scripts/ui-audit.mjs",
    "audit:routes": "node scripts/route-check.mjs",
