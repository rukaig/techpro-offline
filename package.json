{
  "name": "techpro-coc1",
  "version": "1.0.0",
  "private": true,
  "description": "TechPro CSS NC II \u2014 COC 1 interactive learning site for Assemble Computer Hardware",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prestart": "npm run build:knowledge && npm run build:games",
    "dev": "node --watch server.js",
    "predev": "npm run build:knowledge && npm run build:games",
    "test": "node --test",
    "pretest": "npm run build:knowledge && npm run build:games",
    "check": "node scripts/check-content.js",
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "build:games": "node scripts/build-games.mjs",
    "audit": "node scripts/ui-audit.mjs",
    "audit:routes": "node scripts/route-check.mjs",
    "test:pclab": "node tests/pc-lab-regression.mjs",
    "assistant:smoke": "node scripts/assistant-smoke.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "compression": "^1.7.4",
    "dotenv": "^18.0.9",
    "esbuild": "0.28.2",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "qrcode": "^1.5.4",
    "three": "0.187.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
