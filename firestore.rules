rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    match /techpro_users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && onlyFields([
        'displayName', 'email', 'photoURL', 'grade', 'section', 'classCode',
        'role', 'avatarColor', 'updatedAt', 'createdAt'
      ]);
      allow delete: if isOwner(uid);

      match /plan/{planId} {
        allow read: if isOwner(uid) && planId == 'current';
        allow create, update: if isOwner(uid)
          && planId == 'current'
          && onlyFields(['config', 'tasks', 'sessions', 'reminderDay', 'syncUid', 'updatedAt'])
          && request.resource.data.syncUid == uid
          && (request.resource.data.config == null || request.resource.data.config is map)
          && request.resource.data.tasks is list
          && request.resource.data.tasks.size() <= 200
          && request.resource.data.sessions is list
          && request.resource.data.sessions.size() <= 1200
          && (request.resource.data.reminderDay == null || request.resource.data.reminderDay is string);
        allow delete: if isOwner(uid) && planId == 'current';
      }
    }

    match /techpro_progress/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /techpro_scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'activity', 'score', 'accuracy', 'timeMs',
          'strikes', 'stars', 'rating', 'grade', 'section', 'createdAt', 'mode'
        ])
        && request.resource.data.activity in ['pc-lab', 'final-exam', 'duel', 'daily'];
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /techpro_assistant/{uid}/{document=**} {
      allow read, write: if false;
    }
  }
}
